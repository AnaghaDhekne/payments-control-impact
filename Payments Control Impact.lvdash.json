{
  "datasets": [
    {
      "name": "summary",
      "displayName": "Held-out Summary (Gates)",
      "queryLines": [
        "SELECT\n",
        "  metric,\n",
        "  CAST(value AS INT) AS value,\n",
        "  CAST(total AS INT) AS total,\n",
        "  CONCAT(CAST(CAST(value AS INT) AS STRING), ' / ', CAST(CAST(total AS INT) AS STRING)) AS result,\n",
        "  CAST(REGEXP_REPLACE(pct, '%', '') AS DOUBLE) AS pct,\n",
        "  target,\n",
        "  status\n",
        "FROM\n",
        "  default.payments_heldout_summary\n",
        "ORDER BY\n",
        "  CASE\n",
        "    WHEN status = 'PASS' THEN 0\n",
        "    WHEN status = 'INFO' THEN 1\n",
        "    ELSE 2\n",
        "  END"
      ]
    },
    {
      "name": "cases",
      "displayName": "Held-out Per-Case Results",
      "queryLines": [
        "SELECT\n",
        "  change_id,\n",
        "  CAST(key_misses AS INT) AS key_misses,\n",
        "  CAST(key_recovered AS INT) AS key_recovered,\n",
        "  CASE\n",
        "    WHEN recovery = 'N/A' THEN NULL\n",
        "    ELSE CAST(REGEXP_REPLACE(recovery, '%', '') AS DOUBLE)\n",
        "  END AS recovery,\n",
        "  CAST(new_controls AS INT) AS new_controls,\n",
        "  CAST(true_new AS INT) AS true_new,\n",
        "  CASE\n",
        "    WHEN precision = 'N/A' THEN NULL\n",
        "    ELSE CAST(REGEXP_REPLACE(precision, '%', '') AS DOUBLE)\n",
        "  END AS precision,\n",
        "  CAST(total_edges AS INT) AS total_edges,\n",
        "  CAST(correct_edges AS INT) AS correct_edges,\n",
        "  split,\n",
        "  degradation\n",
        "FROM\n",
        "  default.payments_heldout_cases\n",
        "ORDER BY\n",
        "  key_misses DESC"
      ]
    },
    {
      "name": "strategy_comparison",
      "displayName": "Strategy Comparison (Reshaped)",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN strategy = 'Metadata-only baseline' THEN 'Metadata-only'\n",
        "    WHEN\n",
        "      strategy = 'Lineage repair'\n",
        "      AND investment_pct = 70.0\n",
        "    THEN\n",
        "      'Lineage repair 70%'\n",
        "    WHEN strategy = 'AI Phase 1 (Llama 4 Maverick)' THEN 'AI Phase 1'\n",
        "    WHEN strategy = 'AI Phase 2 (GPT OSS 120B)' THEN 'AI Phase 2'\n",
        "  END AS strategy_label,\n",
        "  'Key Recall' AS metric,\n",
        "  CASE\n",
        "    WHEN CAST(key_recall AS DOUBLE) < 1 THEN CAST(key_recall AS DOUBLE) * 100\n",
        "    ELSE CAST(key_recall AS DOUBLE)\n",
        "  END AS value\n",
        "FROM\n",
        "  workspace.default.payments_baseline_repair\n",
        "WHERE\n",
        "  (\n",
        "    strategy = 'Metadata-only baseline'\n",
        "    AND investment_pct = 0.0\n",
        "  )\n",
        "  OR (\n",
        "    strategy = 'Lineage repair'\n",
        "    AND investment_pct = 70.0\n",
        "  )\n",
        "  OR strategy LIKE 'AI%'\n",
        "UNION ALL\n",
        "SELECT\n",
        "  CASE\n",
        "    WHEN strategy = 'Metadata-only baseline' THEN 'Metadata-only'\n",
        "    WHEN\n",
        "      strategy = 'Lineage repair'\n",
        "      AND investment_pct = 70.0\n",
        "    THEN\n",
        "      'Lineage repair 70%'\n",
        "    WHEN strategy = 'AI Phase 1 (Llama 4 Maverick)' THEN 'AI Phase 1'\n",
        "    WHEN strategy = 'AI Phase 2 (GPT OSS 120B)' THEN 'AI Phase 2'\n",
        "  END AS strategy_label,\n",
        "  'Precision' AS metric,\n",
        "  CAST(precision_pct AS DOUBLE) AS value\n",
        "FROM\n",
        "  workspace.default.payments_baseline_repair\n",
        "WHERE\n",
        "  (\n",
        "    strategy = 'Metadata-only baseline'\n",
        "    AND investment_pct = 0.0\n",
        "  )\n",
        "  OR (\n",
        "    strategy = 'Lineage repair'\n",
        "    AND investment_pct = 70.0\n",
        "  )\n",
        "  OR strategy LIKE 'AI%'"
      ]
    },
    {
      "name": "baseline_repair",
      "displayName": "Baseline & Repair Comparison",
      "queryLines": [
        "SELECT\n",
        "  strategy,\n",
        "  CAST(investment_pct AS DOUBLE) AS investment_pct,\n",
        "  CONCAT(CAST(investment_pct AS STRING), '%') AS investment_pct_label,\n",
        "  CASE\n",
        "    WHEN strategy = 'Metadata-only baseline' THEN 'Baseline'\n",
        "    WHEN strategy = 'Lineage repair' THEN CONCAT(CAST(investment_pct AS STRING), '% repair')\n",
        "    WHEN strategy = 'AI Phase 1 (Llama 4 Maverick)' THEN 'AI Phase 1'\n",
        "    WHEN strategy = 'AI Phase 2 (GPT OSS 120B)' THEN 'AI Phase 2'\n",
        "  END AS display_label,\n",
        "  CASE\n",
        "    WHEN CAST(key_recall AS DOUBLE) < 1 THEN CAST(key_recall AS DOUBLE) * 100\n",
        "    ELSE CAST(key_recall AS DOUBLE)\n",
        "  END AS key_recall,\n",
        "  ROUND(\n",
        "    CASE\n",
        "      WHEN CAST(key_recall AS DOUBLE) < 1 THEN CAST(key_recall AS DOUBLE) * 100\n",
        "      ELSE CAST(key_recall AS DOUBLE)\n",
        "    END - 11.111, 1\n",
        "  ) AS improvement_pp,\n",
        "  CASE\n",
        "    WHEN CAST(recovery AS DOUBLE) < 1 THEN CAST(recovery AS DOUBLE) * 100\n",
        "    ELSE CAST(recovery AS DOUBLE)\n",
        "  END AS recovery,\n",
        "  CAST(precision_pct AS DOUBLE) AS precision_pct,\n",
        "  CAST(false_positives AS INT) AS false_positives,\n",
        "  CAST(workload_increase AS DOUBLE) AS workload_increase,\n",
        "  CASE\n",
        "    WHEN CAST(precision_pct AS DOUBLE) >= 100.0 THEN '100% Precision (0 false positives)'\n",
        "    WHEN CAST(precision_pct AS DOUBLE) >= 99.0 THEN '99%+ Precision'\n",
        "    ELSE '<99% Precision'\n",
        "  END AS precision_category,\n",
        "  description\n",
        "FROM\n",
        "  workspace.default.payments_baseline_repair\n",
        "ORDER BY\n",
        "  CASE\n",
        "    WHEN strategy = 'Metadata-only baseline' THEN 0\n",
        "    WHEN strategy = 'Lineage repair' THEN 1\n",
        "    WHEN strategy = 'AI Phase 1 (Llama 4 Maverick)' THEN 2\n",
        "    WHEN strategy = 'AI Phase 2 (GPT OSS 120B)' THEN 3\n",
        "  END,\n",
        "  investment_pct"
      ]
    },
    {
      "name": "degradation_grid",
      "displayName": "Degradation Impact Grid",
      "queryLines": [
        "SELECT\n",
        "  CAST(level AS INT) AS level,\n",
        "  CONCAT(CAST(level AS STRING), '%') AS level_label,\n",
        "  mode,\n",
        "  CAST(key_recall AS DOUBLE) * 100 AS key_recall,\n",
        "  CAST(affected_recall AS DOUBLE) * 100 AS affected_recall,\n",
        "  CAST(workload AS INT) AS workload,\n",
        "  CAST(unreachable_key AS INT) AS unreachable_key,\n",
        "  CAST(cases AS INT) AS cases\n",
        "FROM\n",
        "  workspace.default.payments_degradation_grid\n",
        "ORDER BY\n",
        "  level,\n",
        "  mode"
      ]
    },
    {
      "name": "cases_percent",
      "displayName": "Per-Case Percent Metrics",
      "config": {
        "version": "1.1",
        "source": "SELECT change_id, metric, value FROM (\n  SELECT change_id, 'Recovery Rate' AS metric, CAST(key_misses AS INT) AS sort_key,\n    CASE WHEN recovery = 'N/A' THEN NULL\n      ELSE CAST(REGEXP_REPLACE(recovery, '%', '') AS DOUBLE) END AS value\n  FROM default.payments_heldout_cases\n  UNION ALL\n  SELECT change_id, 'Precision' AS metric, CAST(key_misses AS INT) AS sort_key,\n    CASE WHEN precision = 'N/A' THEN NULL\n      ELSE CAST(REGEXP_REPLACE(precision, '%', '') AS DOUBLE) END AS value\n  FROM default.payments_heldout_cases\n  UNION ALL\n  SELECT change_id, 'Edge Correctness' AS metric, CAST(key_misses AS INT) AS sort_key,\n    CASE WHEN CAST(total_edges AS INT) = 0 THEN NULL\n      ELSE CAST(correct_edges AS INT) * 100.0 / CAST(total_edges AS INT) END AS value\n  FROM default.payments_heldout_cases\n) metric_rows ORDER BY metric_rows.sort_key DESC, metric_rows.change_id\n",
        "dimensions": [
          {
            "name": "change_id",
            "expr": "change_id",
            "displayName": "Change ID"
          },
          {
            "name": "metric",
            "expr": "metric",
            "displayName": "Metric"
          }
        ],
        "measures": [
          {
            "name": "value",
            "expr": "AVG(value)",
            "displayName": "Percentage"
          }
        ]
      }
    }
  ],
