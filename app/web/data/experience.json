 "glossary": [
  {
   "term": "Control",
   "meaning": "A check that prevents or detects a problem in the payment flow, owned by a person or team."
  },
  {
   "term": "Key control",
   "meaning": "A control the bank relies on most (30 of the 101 here). Missing one is the costliest error, so the main metric is about key controls."
  },
  {
   "term": "Change",
   "meaning": "A release that alters a field mapping, rule, report, interface or system. The benchmark has 54."
  },
  {
   "term": "Lineage",
   "meaning": "The map of dependencies: which fields feed which rules, systems, reports and controls."
  },
  {
   "term": "Degradation",
   "meaning": "Deliberately removing lineage links near the change (30% in the main test) to mimic real, incomplete metadata."
  },
  {
   "term": "Rules baseline",
   "meaning": "The non-AI method: follow visible lineage links from the changed item to every control they reach."
  },
  {
   "term": "Key miss",
   "meaning": "An affected key control the rules baseline does not find. Recovering these is the agent's job."
  },
  {
   "term": "Agent / detective",
   "meaning": "An LLM that chooses read-only tools step by step (explore the map, search and read procedures) and submits findings."
  },
  {
   "term": "Finding",
   "meaning": "A decision on one control (AFFECTED, UNAFFECTED, UNCERTAIN) with exact quotes from the ticket and procedure and a stated reason."
  },
  {
   "term": "Verifier",
   "meaning": "A second, independent model call that checks each finding. If it disagrees, the control goes to a human."
  },
  {
   "term": "UNCERTAIN / review item",
   "meaning": "A control sent to a person to decide. Counted as workload, never as a recovery."
  },
  {
   "term": "Precision",
   "meaning": "Of the controls the agent newly recommends, the share that are truly affected."
  },
  {
   "term": "Answer key",
   "meaning": "The true affected controls, computed from the complete hidden map. The agent never sees it."
  },
  {
   "term": "Development vs held-out",
   "meaning": "Development cases may be looked at while building; the 18 held-out cases are run once, at the end, with everything frozen."
  },
  {
   "term": "Frozen check",
   "meaning": "A run on development cases never inspected during fixing, with code fixed in advance: the fairest result before the held-out run."
  },
  {
   "term": "Variant A / B",
   "meaning": "Two versions of the agent. B must cite a chain from the change to the control before claiming AFFECTED."
  }
 ],
