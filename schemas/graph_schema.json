{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Payments Control Impact Hidden Dependency Graph",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["PROCESS","SYSTEM","INTERFACE","DATA_ELEMENT","RULE","REPORT","EVIDENCE","CONTROL"]},
          "name": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}, "default": []},
          "description": {"type": "string"},
          "criticality": {"enum": ["KEY","STANDARD","SUPPORTING"]},
          "active": {"type": "boolean", "default": true}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","source","target","relationship"],
        "properties": {
          "id": {"type": "string"},
          "source": {"type": "string"},
          "target": {"type": "string"},
          "relationship": {"enum": ["USES","PRODUCES","FEEDS","TRANSFORMS","VALIDATES","SCREENS","EVIDENCES","GOVERNED_BY","DEPENDS_ON","COMPENSATED_BY"]},
          "direct": {"type": "boolean", "default": true},
          "valid_from": {"type": ["string","null"], "format": "date"},
          "valid_to": {"type": ["string","null"], "format": "date"},
          "metadata_exposable": {"type": "boolean", "default": true}
        }
      }
    }
  }
}